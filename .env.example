# Copia este archivo como .env y ajusta los valores por entorno.
# Vite solo expone al cliente las variables que empiezan por VITE_.

# URL base de la API (sin barra final). Ej: https://api.midominio.com/api
VITE_API_URL=http://localhost:3000/api

# URL del servidor de sockets / chat (misma base, sin /api)
VITE_REALTIME_URL=http://localhost:3000
